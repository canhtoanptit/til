APP_TOKEN=dev-token

# ADR-0010: which adapter set to run. `local` = Readability extraction +
# Ollama bge-m3 + D1VectorStore (works fully offline). `cloud` = env.AI
# toMarkdown + Workers AI bge-m3 + Vectorize, which needs those bindings
# uncommented in wrangler.jsonc plus CLOUDFLARE_API_TOKEN. Unset means `local`.
TIL_STACK=local

# Which embedding leg `local` mode uses (ADR-0010 amendment):
#   ollama      — Ollama at OLLAMA_BASE_URL; fully offline (default when unset)
#   workers-ai  — Workers AI @cf/baai/bge-m3 over its REST API; needs the two
#                 CF_* vars below and spends neurons, but needs no local model
# Both produce 1024-d bge-m3 vectors, so they are interchangeable without a
# re-embed. Anything else warns and falls back to `ollama`. Ignored when
# TIL_STACK=cloud, which always uses the env.AI binding.
TIL_EMBEDDER=ollama

# Where the local embedder lives; defaults to http://localhost:11434.
# Requires `ollama pull bge-m3`. If Ollama is not running, ingest still
# succeeds but entries stay unindexed and GET /api/health reports
# `embedder: "unavailable"` — POST /api/entries/reembed backfills them later.
OLLAMA_BASE_URL=http://localhost:11434

# Only for TIL_EMBEDDER=workers-ai (and for `pnpm --filter @til/evals eval:*`,
# which reads this file when the values are not already in the environment).
# CF_ACCOUNT_ID: Cloudflare dashboard → Workers & Pages → Account ID.
# WORKERS_AI_API_TOKEN: an API token with the "Workers AI — Read" permission.
# With either missing, TIL_EMBEDDER=workers-ai warns once, runs without an
# embedder, and search degrades to FTS-only.
CF_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
