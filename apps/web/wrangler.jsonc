{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "til",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  // M3: the Agents SDK statically imports node:async_hooks (AsyncLocalStorage
  // for agent context) and node:diagnostics_channel, so the worker no longer
  // loads without it. `nodejs_als` alone is not enough — it covers only
  // async_hooks. This supersedes ADR-0002's "nodejs_compat is no longer needed".
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "til",
      "database_id": "local-placeholder",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "workflows": [
    {
      "name": "til-digest",
      "binding": "DIGEST",
      "class_name": "DigestWorkflow",
    },
  ],
  // M3: the chat agent. The Agents SDK routes /{prefix}/{kebab binding}/{id},
  // so binding CHAT + prefix "api" resolves the contract path /api/chat/:id.
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "TilChatAgent",
      },
    ],
  },
  "migrations": [
    {
      // new_sqlite_classes, not new_classes: Agents SDK agents keep their state
      // in SQLite-backed DO storage (this.sql / ctx.storage.sql).
      "tag": "v1",
      "new_sqlite_classes": ["TilChatAgent"],
    },
  ],
  "triggers": {
    // M2: weekly "interesting things" digest, Monday 08:00 UTC.
    "crons": ["0 8 * * 1"],
  },
  "vars": {
    // ADR-0010: the deployed default. There is no Ollama at the edge, so a
    // deploy must run the Workers AI + Vectorize adapters. Local dev overrides
    // this to "local" via .dev.vars; unset resolves to "local".
    "TIL_STACK": "cloud",
  },
  // P6 (deploy): enable — the AI binding has no local emulation and requires
  // CLOUDFLARE_API_TOKEN + a remote proxy session, which blocks unauthenticated
  // local `vite dev`. Until then TIL_STACK=cloud degrades to a null embedder.
  // "ai": { "binding": "AI" }
  // P6 (deploy): enable — Vectorize has no local emulation in miniflare/wrangler
  // dev, so `local` mode uses the D1VectorStore instead.
  // "vectorize": [{ "binding": "VECTORIZE", "index_name": "til-entries" }]
}
